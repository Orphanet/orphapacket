        "Label": "Micturition-induced epilepsy",
        "PURL": "http://www.orpha.net/ORDO/Orphanet_166430",
        "DisorderType": {
            "value": "Disease",
            "PURL": "http://www.orpha.net/ORDO/Orphanet_377788"
        },
        "TextSection": {
            "TextSectionType": "Definition",
            "Contents": "A rare reflex epilepsy characterized by tonic posturing or clonic movements triggered by micturition with bilateral or unilateral involvement of the extremities and with or without loss of consciousness. Developmental delay is reported in some cases."
        },
